@model IEnumerable<mvc.Models.TipoInmueble>

@{
    ViewData["Title"] = "Tipos de Inmueble";
}

<div class="management-page">
    <div class="page-header">
        <div>
            <h1>GESTIÓN DE TIPOS DE INMUEBLE</h1>
        </div>
        <a asp-action="Create" class="btn-primary-custom">
            <span class="btn-icon">+</span>
            Agregar tipo
        </a>
    </div>

    <div class="data-card">
        <div class="table-responsive">
            <div class="data-card-header d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3 p-3 border-bottom">
    <div>
        <h2 class="m-0">Tipos registrados</h2>
    </div>
    <div class="search-box">
        <span>⌕</span>

        <input type="text"
            id="buscadorTipos"
            placeholder="Buscar tipo..."
            value="@ViewBag.Busqueda" />
    </div>
</div>
            <table class="table custom-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Descripción</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td><strong>@item.Descripcion</strong></td>
                            <td>
                                <div class="action-buttons justify-content-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-edit">Editar</a>
                                    @if (Context.Session.GetString("Rol")?.ToUpper() == "ADMINISTRADOR")
                                    {   
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-delete">Eliminar</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<nav aria-label="Navegacion" class="mt-4">
    <ul class="pagination justify-content-center">
        <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">
            <a class="page-link"
            href="@Url.Action("Index", new {
                pagina = ViewBag.PaginaActual - 1,
                busqueda = ViewBag.Busqueda
            })">
                Anterior
            </a>
        <li class="page-item active">
            <span class="page-link">Página @ViewBag.PaginaActual</span>
        </li>
        <li class="page-item @(Model.Count() < 10 ? "disabled" : "")">
            <a class="page-link"
            href="@Url.Action("Index", new {
                pagina = ViewBag.PaginaActual + 1,
                busqueda = ViewBag.Busqueda
            })">
                Siguiente
            </a>
        </li>
    </ul>
</nav>

<script>
    const buscadorTipos = document.getElementById("buscadorTipos");

    let temporizador;

    buscadorTipos.addEventListener("input", function () {

        clearTimeout(temporizador);

        temporizador = setTimeout(function () {

            const valor = buscadorTipos.value.trim();

            const url = new URL(window.location.href);

            url.searchParams.set("pagina", "1");

            if (valor === "") {
                url.searchParams.delete("busqueda");
            } else {
                url.searchParams.set("busqueda", valor);
            }

            window.location.href = url.toString();

        }, 300);

    });
</script>