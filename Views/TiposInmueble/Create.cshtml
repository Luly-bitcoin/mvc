@model mvc.Models.TipoInmueble

@{
    ViewData["Title"] = "Agregar Tipo de Inmueble";
}

<div class="management-page">
    <div class="page-header">
        <div>
            <h1>AGREGAR TIPO DE INMUEBLE</h1>
        </div>
    </div>

    <div class="form-card">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="form-grid">
                <div class="form-group-custom form-group-full">
                    <label asp-for="Descripcion">Descripción</label>
                    <input asp-for="Descripcion" class="form-control-custom" placeholder="Ej. Cabaña" />
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
            </div>
            <div class="form-actions">
                <a asp-action="Index" class="btn-secondary-custom">Cancelar</a>
                <button type="submit" class="btn-primary-custom">Guardar tipo</button>
            </div>
        </form>
    </div>
</div>