@model mvc.Models.Pago

@{
    ViewData["Title"] = "Registrar Pago";
    var reserva = ViewBag.Reserva;
    
    // Calculamos el total basado en los días de la reserva y el monto diario si la reserva existe
    decimal montoTotal = 0;
    if (reserva != null)
    {
        var dias = (reserva.FechaHasta - reserva.FechaDesde).Days;
        if (dias <= 0) { dias = 1; } // Por si es el mismo día
        montoTotal = reserva.MontoDiario * dias;
    }
}

<div class="management-page">
    <div class="page-header">
        <h1>Registrar Nuevo Pago</h1>
    </div>

    <div class="data-card p-4" style="max-width: 600px;">
        @if (reserva != null)
        {
            <div class="mb-3 alert alert-info">
                <strong>Reserva ID:</strong> @reserva.Id <br />
                <strong>Inmueble:</strong> @reserva.InmuebleDireccion <br />
                <strong>Monto Diario:</strong> @reserva.MontoDiario.ToString("C") <br />
                <strong>Monto Total Estimado:</strong> @montoTotal.ToString("C")
            </div>
        }

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdReserva" />

            <div class="mb-3">
                <label asp-for="Fecha" class="form-label">Fecha</label>
                <input asp-for="Fecha" type="date" class="form-control-custom w-100" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Importe" class="form-label">Importe</label>
                <input asp-for="Importe" type="number" step="0.01" class="form-control-custom w-100" />
                <span asp-validation-for="Importe" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Concepto" class="form-label">Concepto</label>
                <input asp-for="Concepto" class="form-control-custom w-100" />
                <span asp-validation-for="Concepto" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-primary-custom">Guardar Pago</button>
                <a asp-action="Index" asp-route-idReserva="@Model.IdReserva" class="btn-secondary-custom text-decoration-none d-flex align-items-center">Cancelar</a>
            </div>
        </form>
    </div>
</div>