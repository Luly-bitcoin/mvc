@model IEnumerable<mvc.Models.Pago>
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Pagos de la Reserva";
    var reserva = ViewBag.Reserva;
}

<div class="management-page">
    <div class="page-header">
        <div>
            <h1>GESTIÓN DE PAGOS</h1>
            @if (reserva != null)
            {
                <p class="text-muted m-0">Reserva #@reserva.Id - Inmueble: @reserva.InmuebleDireccion</p>
            }
        </div>
        <a asp-action="Create" asp-route-idReserva="@ViewBag.IdReserva" class="btn-primary-custom">
            <span class="btn-icon">+</span>
            Registrar pago
        </a>
    </div>

    <div class="data-card">
        <div class="table-responsive">
            <table class="table custom-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Fecha</th>
                        <th>Concepto</th>
                        <th>Importe</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td><strong>@item.Concepto</strong></td>
                            <td>@(item.Importe.ToString("C"))</td>
                            <td>
                                @if (item.Activo == 1)
                                {
                                    <span class="status-badge status-active">Válido</span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">Anulado</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons justify-content-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-edit">Editar</a>
                                    
                                    @if (item.Activo == 1)
                                    {
                                        <form asp-action="Anular" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-action btn-delete" onclick="return confirm('¿Estás seguro de anular este pago?');">Anular</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="mt-3">
        <a asp-controller="Reservas" asp-action="Index" class="btn-secondary-custom text-decoration-none">Volver a Reservas</a>
    </div>
</div>