@model mvc.Models.Inmueble

@{
    ViewData["Title"] = "Agregar inmueble";
}

<div class="management-page">

    <div class="page-header">

        <div>
            <h1>AGREGAR INMUEBLE</h1>
        </div>

    </div>

    <div class="form-card">

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="form-grid">

                <div class="form-group-custom">
                    <label asp-for="IdPropietario">
                        Propietario
                    </label>

                    <select asp-for="IdPropietario"
                            asp-items="ViewBag.Propietarios"
                            class="form-control-custom">
                        <option value="">Seleccionar propietario</option>
                    </select>

                    <span asp-validation-for="IdPropietario"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-group-custom">
                    <label asp-for="Tipo">
                        Tipo de inmueble
                    </label>

                    <input asp-for="Tipo"
                           class="form-control-custom"
                           placeholder="Ej. Casa, departamento, loft..." />

                    <span asp-validation-for="Tipo"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-group-custom form-group-full">
                    <label asp-for="Direccion">
                        Dirección
                    </label>

                    <input asp-for="Direccion"
                           class="form-control-custom"
                           placeholder="Ingrese la dirección del inmueble" />

                    <span asp-validation-for="Direccion"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-group-custom">
                    <label asp-for="Cupo">
                        Capacidad de personas
                    </label>

                    <input asp-for="Cupo"
                           type="number"
                           min="1"
                           class="form-control-custom"
                           placeholder="Ej. 4" />

                    <span asp-validation-for="Cupo"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-group-custom">
                    <label asp-for="Precio">
                        Precio por día
                    </label>

                    <input asp-for="Precio"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control-custom"
                           placeholder="Ej. 50000" />

                    <span asp-validation-for="Precio"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-group-custom form-group-full">
                    <label asp-for="Coord">
                        📍 Ubicación del inmueble
                    </label>

                    <div class="coord-input-container">

                        <input asp-for="Coord"
                            id="coordInput"
                            class="form-control-custom"
                            placeholder="Ej. -33.3012, -66.3378" />

                        <a href="https://www.google.com/maps"
                        target="_blank"
                        class="btn-map-custom">
                            🗺️ Abrir Google Maps
                        </a>

                    </div>

                    <small class="coord-help">
                        Buscá el inmueble en Google Maps y copiá sus coordenadas.
                        Ejemplo: -33.3012, -66.3378
                    </small>

                    <span asp-validation-for="Coord"
                        class="text-danger">
                    </span>
                </div>

                <div class="form-group-custom form-group-full">

                    <label>Foto de portada</label>

                    <label class="file-upload">

                        <input type="file"
                            name="fotoPortada"
                            accept="image/*"
                            onchange="mostrarVistaPrevia(this, 'preview-portada', 'nombre-portada')" />

                        <span class="file-upload-icon">📷</span>

                        <span class="file-upload-text">
                            <strong>Seleccionar foto</strong>
                            <small>JPG, PNG o WEBP</small>
                        </span>

                    </label>

                    <span id="nombre-portada" class="file-name">
                        Ningún archivo seleccionado
                    </span>

                    <!-- Vista previa -->

                    <div id="preview-portada" class="image-preview-container">
                    </div>

                </div>


                <div class="form-group-custom form-group-full">

                    <label>Otras fotos</label>

                    <label class="file-upload">

                        <input type="file"
                            name="fotos"
                            accept="image/*"
                            multiple
                            onchange="mostrarVistasPrevias(this, 'preview-fotos', 'nombre-fotos')" />

                        <span class="file-upload-icon">🖼️</span>

                        <span class="file-upload-text">
                            <strong>Agregar otras fotos</strong>
                            <small>Podés seleccionar varias imágenes</small>
                        </span>

                    </label>

                    <span id="nombre-fotos" class="file-name">
                        Ningún archivo seleccionado
                    </span>

                    <!-- Vistas previas -->

                    <div id="preview-fotos" class="images-preview-grid">
                    </div>

                </div>

            </div>

            <div class="form-actions">

                <a asp-action="Index"
                   class="btn-secondary-custom">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn-primary-custom">
                    Guardar inmueble
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        // FOTO DE PORTADA
        function mostrarVistaPrevia(input, previewId, nombreId) {

            const preview = document.getElementById(previewId);
            const nombre = document.getElementById(nombreId);

            preview.innerHTML = "";

            if (input.files && input.files.length > 0) {

                const archivo = input.files[0];

                nombre.textContent = "✓ " + archivo.name;

                const reader = new FileReader();

                reader.onload = function (e) {

                    const img = document.createElement("img");

                    img.src = e.target.result;
                    img.classList.add("image-preview");

                    preview.appendChild(img);
                };

                reader.readAsDataURL(archivo);

            } else {

                nombre.textContent = "Ningún archivo seleccionado";
            }
        }


        // OTRAS FOTOS
        function mostrarVistasPrevias(input, previewId, nombreId) {

            const preview = document.getElementById(previewId);
            const nombre = document.getElementById(nombreId);

            preview.innerHTML = "";

            if (input.files && input.files.length > 0) {

                nombre.textContent =
                    "✓ " +
                    input.files.length +
                    " foto(s) seleccionada(s)";

                Array.from(input.files).forEach(function (archivo) {

                    const reader = new FileReader();

                    reader.onload = function (e) {

                        const img = document.createElement("img");

                        img.src = e.target.result;
                        img.classList.add("image-preview-small");

                        preview.appendChild(img);
                    };

                    reader.readAsDataURL(archivo);

                });

            } else {

                nombre.textContent = "Ningún archivo seleccionado";
            }
        }

    </script>
}