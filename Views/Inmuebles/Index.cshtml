@model IEnumerable<mvc.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles";
}

<div class="management-page">

    <div class="page-header">

        <div>
            <h1>GESTIÓN DE INMUEBLES</h1>
        </div>

        <a asp-action="Create" class="btn-primary-custom">
            <span class="btn-icon">+</span>
            Agregar inmueble
        </a>

    </div>

   <div class="data-card-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h2>Inmuebles registrados</h2>
    </div>
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <input type="text" name="ubicacion" class="form-control-custom" placeholder="Buscar dirección..." value="@ViewBag.Ubicacion" style="width: 250px;" />
        <button type="submit" class="btn-primary-custom">Buscar</button>
        @if (!string.IsNullOrEmpty(ViewBag.Ubicacion))
        {
            <a asp-action="Index" class="btn-secondary-custom text-decoration-none d-flex align-items-center">Limpiar</a>
        }
    </form>
</div>
        <div class="table-responsive">

            <table class="table custom-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Foto</th>
                        <th>Dirección</th>
                        <th>Tipo</th>
                        <th>Propietario</th>
                        <th>Cupo</th>
                        <th>Precio por día</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var inmueble in Model)
                    {
                        <tr>

                            <td>
                                @if (!string.IsNullOrEmpty(inmueble.FotoPortada))
                                {
                                    <img src="@inmueble.FotoPortada"
                                         alt="Foto de @inmueble.Direccion"
                                         class="property-thumb" />
                                }
                                else
                                {
                                    <div class="property-placeholder">
                                        🏠
                                    </div>
                                }
                            </td>

                            <td>
                                <strong>@inmueble.Direccion</strong>
                            </td>

                            <td>
                                @inmueble.TipoNombre
                            </td>

                            <td>
                                @inmueble.PropietarioNombre
                            </td>

                            <td>
                                @inmueble.Cupo personas
                            </td>

                            <td>
                                <strong>
                                    @inmueble.Precio.ToString("C")
                                </strong>
                            </td>

                            <td>
                                @if (inmueble.Activo == 1)
                                {
                                    <span class="status-badge status-active">
                                        Disponible
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">
                                        No disponible
                                    </span>
                                }
                            </td>

                            <td>

                                <div class="action-buttons">

                                    <a asp-action="Details"
                                       asp-route-id="@inmueble.Id"
                                       class="btn-action btn-view">
                                        Ver
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@inmueble.Id"
                                       class="btn-action btn-edit">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@inmueble.Id"
                                       class="btn-action btn-delete">
                                        Eliminar
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
<nav aria-label="Navegacion" class="mt-4">
    <ul class="pagination justify-content-center">
        <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">
            <a class="page-link" href="@Url.Action("Index", new { pagina = ViewBag.PaginaActual - 1 })">Anterior</a>
        </li>
        
        <li class="page-item active">
            <span class="page-link">Página @ViewBag.PaginaActual</span>
        </li>

        <li class="page-item @(Model.Count() < 10 ? "disabled" : "")">
            <a class="page-link" href="@Url.Action("Index", new { pagina = ViewBag.PaginaActual + 1 })">Siguiente</a>
        </li>
    </ul>
</nav>