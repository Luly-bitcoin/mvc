@model mvc.Models.Inmueble

@{
    ViewData["Title"] = "Editar inmueble";
}

<div class="management-page">

    <div class="page-header">

        <div>
            <h1>EDITAR INMUEBLE</h1>
        </div>

    </div>

    <div class="form-card">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="form-grid">

                <div class="form-group-custom">

                    <label asp-for="IdPropietario">
                        Propietario
                    </label>

                    <select asp-for="IdPropietario"
                            asp-items="ViewBag.Propietarios"
                            class="form-control-custom">
                        <option value="">Seleccionar propietario</option>
                    </select>

                    <span asp-validation-for="IdPropietario"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group-custom">

                    <label asp-for="Tipo">
                        Tipo de inmueble
                    </label>

                    <input asp-for="Tipo"
                           class="form-control-custom" />

                    <span asp-validation-for="Tipo"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group-custom form-group-full">

                    <label asp-for="Direccion">
                        Dirección
                    </label>

                    <input asp-for="Direccion"
                           class="form-control-custom" />

                    <span asp-validation-for="Direccion"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group-custom">

                    <label asp-for="Cupo">
                        Capacidad de personas
                    </label>

                    <input asp-for="Cupo"
                           type="number"
                           min="1"
                           class="form-control-custom" />

                    <span asp-validation-for="Cupo"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group-custom">

                    <label asp-for="Precio">
                        Precio por día
                    </label>

                    <input asp-for="Precio"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control-custom" />

                    <span asp-validation-for="Precio"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group-custom form-group-full">

                    <label asp-for="Coord">
                        Coordenadas
                    </label>

                    <input asp-for="Coord"
                           class="form-control-custom" />

                </div>

                <div class="form-group-custom form-group-full">

                    <label asp-for="FotoPortada">
                        Foto de portada
                    </label>

                    <input asp-for="FotoPortada"
                           class="form-control-custom" />

                </div>

                <div class="form-group-custom form-group-full">

                    <label asp-for="Fotos">
                        Otras fotos
                    </label>

                    <input asp-for="Fotos"
                           class="form-control-custom" />

                </div>

                <div class="form-group-custom">

                    <label asp-for="Activo">
                        Estado
                    </label>

                    <select asp-for="Activo"
                            class="form-control-custom">

                        <option value="1">
                            Disponible
                        </option>

                        <option value="0">
                            No disponible
                        </option>

                    </select>

                </div>

            </div>

            <div class="form-actions">

                <a asp-action="Index"
                   class="btn-secondary-custom">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn-primary-custom">
                    Guardar cambios
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}