@model IEnumerable<mvc.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="management-page">

    <div class="page-header">
        <div>
            <h1>GESTIÓN DE USUARIOS</h1>
        </div>

        <a asp-controller="Login"
            asp-action="CrearUsuario"
            asp-route-desdeUsuarios="true"
            class="btn-primary-custom">
                <span class="btn-icon">+</span>
                Agregar usuario
        </a>
    </div>


    <div class="data-card">

        <div class="table-responsive">

            <div class="data-card-header d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3 p-3 border-bottom">

                <div>
                    <h2 class="m-0">Usuarios registrados</h2>
                </div>

                <form asp-action="Index" method="get" class="d-flex gap-2 m-0">

                    <input type="text"
                           name="busqueda"
                           class="form-control-custom"
                           placeholder="Buscar usuario..."
                           value="@ViewBag.Busqueda"
                           style="width: 250px;" />

                    <button type="submit" class="btn-primary-custom">
                        Buscar
                    </button>

                    @if (!string.IsNullOrEmpty(ViewBag.Busqueda))
                    {
                        <a asp-action="Index"
                           class="btn-secondary-custom text-decoration-none d-flex align-items-center">
                            Limpiar
                        </a>
                    }

                </form>

            </div>


            <table class="table custom-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>


                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.Id</td>

                            <td>
                                <strong>@item.Nombre</strong>
                            </td>

                            <td>@item.Apellido</td>

                            <td>@item.Email</td>

                            <td>@item.Rol</td>

                            <td>

                                <div class="action-buttons justify-content-center">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn-action btn-edit">
                                        Editar
                                    </a>


                                    <button type="button"
                                            class="btn-action btn-delete"
                                            onclick="confirmarEliminacion(@item.Id, '@item.NombreUsuario')">
                                        Eliminar
                                    </button>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<nav aria-label="Navegacion" class="mt-4">

    <ul class="pagination justify-content-center">

        <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">

            <a class="page-link"
               href="@Url.Action("Index", new { pagina = ViewBag.PaginaActual - 1 })">
                Anterior
            </a>

        </li>


        <li class="page-item active">

            <span class="page-link">
                Página @ViewBag.PaginaActual
            </span>

        </li>


        <li class="page-item @(Model.Count() < 10 ? "disabled" : "")">

            <a class="page-link"
               href="@Url.Action("Index", new { pagina = ViewBag.PaginaActual + 1 })">
                Siguiente
            </a>

        </li>

    </ul>

</nav>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

    function confirmarEliminacion(id, nombreUsuario) {

        Swal.fire({

            title: '¿Eliminar usuario?',

            text: 'Se eliminará el usuario "' + nombreUsuario + '" de la base de datos.',

            icon: 'warning',

            showCancelButton: true,

            confirmButtonColor: '#607d59',

            cancelButtonColor: '#c5abaa',

            confirmButtonText: 'Sí, eliminar',

            cancelButtonText: 'Cancelar'

        }).then((result) => {

            if (result.isConfirmed) {

                var form = document.createElement('form');

                form.method = 'post';

                form.action = '/Usuarios/Delete/' + id;

                document.body.appendChild(form);

                form.submit();

            }

        });

    }

</script>