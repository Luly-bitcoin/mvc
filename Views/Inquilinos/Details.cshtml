@using System.Linq
@model mvc.Models.Inquilino

@{
    ViewData["Title"] = "Detalle del inquilino";

    string iniciales = "";

    if (!string.IsNullOrEmpty(Model.Nombre))
        iniciales += Model.Nombre[0];

    if (!string.IsNullOrEmpty(Model.Apellido))
        iniciales += Model.Apellido[0];
}

<div class="management-page">

    <div class="details-back">
        <a asp-action="Index" class="btn-cancel">
            ← Volver a inquilinos
        </a>
    </div>

    <div class="data-card">

        <div class="details-top">

            <div>

                <div class="edit-card-header">

                    <div class="edit-avatar">
                        @iniciales.ToUpper()
                    </div>

                    <div>
                        <h2>
                            @Model.Nombre @Model.Apellido
                        </h2>

                        <span>
                            Inquilino · DNI @Model.Dni
                        </span>
                    </div>

                </div>

                <div class="details-person-data">

                    <div class="details-person-grid">

                        <div class="form-group">
                            <label>Nombre</label>
                            <div>@Model.Nombre</div>
                        </div>

                        <div class="form-group">
                            <label>Apellido</label>
                            <div>@Model.Apellido</div>
                        </div>

                        <div class="form-group">
                            <label>DNI</label>
                            <div>@Model.Dni</div>
                        </div>

                        <div class="form-group">
                            <label>Teléfono</label>
                            <div>@Model.Telefono</div>
                        </div>

                        <div class="form-group">
                            <label>Email</label>
                            <div>@Model.Email</div>
                        </div>

                    </div>

                </div>

            </div>

            <div class="details-summary">

                <div class="details-summary-header">

                    <h2>Resumen</h2>

                    <span class="data-count">
                        Actividad del inquilino
                    </span>

                </div>

                <div class="details-summary-grid">

                    <div class="details-summary-item">
                        <strong>@(Model.Reservas?.Count() ?? 0)</strong>
                        <span>Alquileres</span>
                    </div>

                    <div class="details-summary-item">
                        <strong>@(Model.Reservas?.Count(r => r.Activo == 1) ?? 0)</strong>
                        <span>Alquiler actual</span>
                    </div>

                    <div class="details-summary-item">
                        <strong>@(Model.Reservas?.Count(r => r.Activo == 0) ?? 0)</strong>
                        <span>Finalizados</span>
                    </div>

                    <div class="details-summary-item">
                        <strong>@(Model.Pagos?.Count() ?? 0)</strong>
                        <span>Pagos realizados</span>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="details-history">

        <div class="page-header">
            <div>
                <h1>HISTORIAL DE ALQUILERES</h1>
            </div>
        </div>

        @if (Model.Reservas != null && Model.Reservas.Any())
        {
            @foreach (var reserva in Model.Reservas.OrderByDescending(r => r.FechaDesde))
            {
                <div class="data-card history-year">

                    <div class="data-card-header">

                        <div>
                            <h2>@reserva.FechaDesde.Year</h2>

                            <span class="data-count">
                                @(reserva.Activo == 1 ? "Alquiler actual" : "Historial anterior")
                            </span>
                        </div>

                    </div>

                    <div class="history-event">

                        <div class="history-date">
                            @reserva.FechaDesde.ToString("MMMM yyyy").ToUpper()
                        </div>

                        <div class="property-event">

                            <div class="property-event-header">

                                <div>
                                    <h3>
                                        Reserva #@reserva.Id
                                    </h3>

                                    <span>
                                        @reserva.InmuebleDireccion
                                    </span>
                                </div>

                                <span class="status-badge @(reserva.Activo == 1 ? "status-rented" : "status-available")">
                                    @(reserva.Activo == 1 ? "ALQUILER ACTUAL" : "FINALIZADO")
                                </span>

                            </div>

                            <div class="property-event-details">

                                <div>
                                    <small>ALQUILER MENSUAL</small>

                                    <div>
                                        $@reserva.MontoDiario.ToString("N0")
                                    </div>
                                </div>

                                <div>
                                    <small>ESTADO DEL PAGO</small>

                                    <div class="payment-ok">
                                        ✓ @(reserva.Activo == 1 ? "Pago al día" : "Finalizado")
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="data-card history-year">
                <div class="history-empty">
                    No hay movimientos registrados para este período.
                </div>
            </div>
        }

    </div>

</div>