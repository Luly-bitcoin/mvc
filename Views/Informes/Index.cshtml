@model IEnumerable<mvc.Models.Pago>

@{
    ViewData["Title"] = "Informes de Pagos";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <hr />

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Reserva ID</th>
                <th>Concepto</th>
                <th>Fecha</th>
                <th>Importe</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.IdReserva</td>
                        <td>@item.Concepto</td>
                        <td>@item.Fecha.ToShortDateString()</td>
                        <td>$@item.Importe</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">No hay registros de pagos para mostrar.</td>
                </tr>
            }
        </tbody>
    </table>
</div>