@model IEnumerable<mvc.Models.Pago>

@{
    ViewData["Title"] = "Informes de Pagos";
    var pagos = Model?.ToList() ?? new List<mvc.Models.Pago>();
    var total = pagos.Sum(p => p.Importe);
}

<div class="management-page">

    <div class="data-card">

        <div class="data-card-header">
            <div>
                <h2>Informes de Pagos</h2>
                <span class="data-count">
                    @pagos.Count pagos registrados
                </span>
            </div>

            <div class="search-box">
                <span>⌕</span>
                <input type="text"
                       id="searchInput"
                       placeholder="Buscar pago..." />
            </div>
        </div>

        <hr />

        @if (pagos.Any())
        {
            <div class="table-responsive mt-4">
                <table class="table align-middle mb-0" id="pagosTable">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Reserva</th>
                            <th>Concepto</th>
                            <th>Fecha</th>
                            <th class="text-end">Importe</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in pagos)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">
                                        #@item.Id
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        Reserva #@item.IdReserva
                                    </span>
                                </td>

                                <td>
                                    @item.Concepto
                                </td>

                                <td>
                                    @item.Fecha.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-end fw-semibold">
                                    $@item.Importe.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <div id="noResults" class="text-center py-5" style="display:none;">
                <h4>No se encontraron pagos</h4>
                <p class="text-muted mb-0">
                    No hay pagos que coincidan con la búsqueda.
                </p>
            </div>
        }
        else
        {
            <div class="text-center py-5">

                <h4>No hay pagos registrados</h4>

                <p class="text-muted mb-0">
                    Todavía no existen registros de pagos para mostrar.
                </p>

            </div>
        }

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const searchInput = document.getElementById("searchInput");
        const table = document.getElementById("pagosTable");
        const noResults = document.getElementById("noResults");

        if (!searchInput || !table) {
            return;
        }

        const rows = table.querySelectorAll("tbody tr");

        searchInput.addEventListener("input", function () {

            const texto = this.value.toLowerCase().trim();
            let encontrados = 0;

            rows.forEach(function (row) {

                const contenido = row.textContent.toLowerCase();

                if (contenido.includes(texto)) {
                    row.style.display = "";
                    encontrados++;
                } else {
                    row.style.display = "none";
                }

            });

            if (noResults) {
                noResults.style.display =
                    encontrados === 0 ? "block" : "none";
            }
        });
    });
</script>