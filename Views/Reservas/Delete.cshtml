@model mvc.Models.Reserva

@{
    ViewData["Title"] = "Eliminar Reserva";
}

<div class="management-page">
    <div class="page-header">
        <div>
            <h1>ELIMINAR RESERVA</h1>
        </div>
    </div>

    <div class="form-card">
        <div class="alert alert-danger mb-4">
            <strong>¡Atención!</strong> ¿Estás seguro de que deseas eliminar (anular) la reserva <strong>#@Model.Id</strong> para el inmueble en <strong>@Model.InmuebleDireccion</strong>?
        </div>

        <div class="property-info-grid mb-4">
            <div class="property-info-item">
                <span>Inquilino</span>
                <strong>@Model.InquilinoNombre</strong>
            </div>
            <div class="property-info-item">
                <span>Fechas</span>
                <strong>@Model.FechaDesde.ToString("dd/MM/yyyy") - @Model.FechaHasta.ToString("dd/MM/yyyy")</strong>
            </div>
        </div>
        
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="form-actions">
                <a asp-action="Index" class="btn-secondary-custom">Cancelar</a>
                <button type="submit" class="btn-delete">Confirmar anulación</button>
            </div>
        </form>
    </div>
</div>