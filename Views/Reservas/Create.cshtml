@model mvc.Models.Reserva

@{
    ViewData["Title"] = "Nueva reserva";
}

<div class="management-page">
    <div class="page-header">
        <div>
            <h1>CREAR NUEVA RESERVA</h1>
        </div>
    </div>

    <div class="form-card">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="form-grid">
                <div class="form-group-custom">
                    <label asp-for="IdInmueble">Inmueble</label>
                    <select asp-for="IdInmueble" asp-items="ViewBag.Inmuebles" class="form-control-custom">
                        <option value="">Seleccionar inmueble</option>
                    </select>
                    <span asp-validation-for="IdInmueble" class="text-danger"></span>
                </div>

                <div class="form-group-custom">
                    <label asp-for="IdInquilino">Inquilino</label>
                    <select asp-for="IdInquilino" asp-items="ViewBag.Inquilinos" class="form-control-custom">
                        <option value="">Seleccionar inquilino</option>
                    </select>
                    <span asp-validation-for="IdInquilino" class="text-danger"></span>
                </div>

                <div class="form-group-custom">
                    <label asp-for="FechaDesde">Fecha Desde</label>
                    <input asp-for="FechaDesde" type="date" class="form-control-custom" />
                    <span asp-validation-for="FechaDesde" class="text-danger"></span>
                </div>

                <div class="form-group-custom">
                    <label asp-for="FechaHasta">Fecha Hasta</label>
                    <input asp-for="FechaHasta" type="date" class="form-control-custom" />
                    <span asp-validation-for="FechaHasta" class="text-danger"></span>
                </div>

                <div class="form-group-custom">
                    <label asp-for="MontoDiario">Monto Diario</label>
                    <input asp-for="MontoDiario" type="number" step="0.01" min="0" class="form-control-custom" />
                    <span asp-validation-for="MontoDiario" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn-secondary-custom">Cancelar</a>
                <button type="submit" class="btn-primary-custom">Guardar reserva</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}