@model IEnumerable<mvc.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<div class="management-page">
    <div class="page-header">
        <div>
            <h1>GESTIÓN DE RESERVAS</h1>
        </div>
        <a asp-action="Create" class="btn-primary-custom">
            <span class="btn-icon">+</span>
            Nueva reserva
        </a>
    </div>

    <div class="data-card">
        <div class="data-card-header d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2>Contratos registrados</h2>
            </div>
            <div class="search-box">
                <span>⌕</span>

                <input type="text"
                    id="buscadorReservas"
                    placeholder="Buscar dirección o inquilino..."
                    value="@ViewBag.Busqueda" />
            </div>
        </div>
        <div class="table-responsive">
            <table class="table custom-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Inmueble</th>
                        <th>Inquilino</th>
                        <th>Desde</th>
                        <th>Hasta</th>
                        <th>Monto Diario</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reserva in Model)
                    {
                        <tr>
                            <td>@reserva.Id</td>
                            <td><strong>@reserva.InmuebleDireccion</strong></td>
                            <td>@reserva.InquilinoNombre</td>
                            <td>@reserva.FechaDesde.ToString("dd/MM/yyyy")</td>
                            <td>@reserva.FechaHasta.ToString("dd/MM/yyyy")</td>
                            <td><strong>@reserva.MontoDiario.ToString("C")</strong></td>
                            <td>
                                @if (reserva.Activo == 1)
                                {
                                    <span class="status-badge status-active">Vigente</span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">Anulada</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a asp-controller="Pagos" asp-action="Index" asp-route-idReserva="@reserva.Id" class="btn-action" style="background-color: #17a2b8; color: white;" title="Ver Pagos">Pagos</a>
                                    <a asp-action="Details" asp-route-id="@reserva.Id" class="btn-action btn-view">Ver</a>
                                    <a asp-action="Edit" asp-route-id="@reserva.Id" class="btn-action btn-edit">Editar</a>
                                    @if (Context.Session.GetString("Rol")?.ToUpper() == "ADMINISTRADOR")
                                    {
                                        <form asp-action="Delete"
                                            asp-route-id="@reserva.Id"
                                            method="post"
                                            style="display:inline;"
                                            class="form-eliminar-reserva">

                                            @Html.AntiForgeryToken()

                                            <button type="button"
                                                    class="action-btn delete"
                                                    onclick="confirmarEliminacion(this)"
                                                    title="Eliminar">
                                                Eliminar
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<nav aria-label="Navegacion" class="mt-4">
    <ul class="pagination justify-content-center">
        <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">
            <a class="page-link" href="@Url.Action("Index", new { pagina = ViewBag.PaginaActual - 1, busqueda = ViewBag.Busqueda })">Anterior</a>
        </li>
        <li class="page-item active">
            <span class="page-link">Página @ViewBag.PaginaActual</span>
        </li>
        <li class="page-item @(Model.Count() < 10 ? "disabled" : "")">
            <a class="page-link" href="@Url.Action("Index", new { pagina = ViewBag.PaginaActual + 1, busqueda = ViewBag.Busqueda })">Siguiente</a>
        </li>
    </ul>
</nav>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function confirmarEliminacion(button) {

        Swal.fire({
            title: '¿Eliminar reserva?',
            text: 'Esta acción eliminará la reserva de la base de datos.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#607d59',
            cancelButtonColor: '#c5abaa',
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar'
        }).then((result) => {

            if (result.isConfirmed) {
                button.closest('form').submit();
            }

        });
    }
</script>

<script>
    const buscadorReservas = document.getElementById("buscadorReservas");

    let temporizadorBusqueda;

    buscadorReservas.addEventListener("input", function () {

        clearTimeout(temporizadorBusqueda);

        temporizadorBusqueda = setTimeout(function () {

            const valor = buscadorReservas.value.trim();

            const url = new URL(window.location.href);

            url.searchParams.set("pagina", "1");

            if (valor === "") {
                url.searchParams.delete("busqueda");
            } else {
                url.searchParams.set("busqueda", valor);
            }

            window.location.href = url.toString();

        }, 300);

    });
</script>