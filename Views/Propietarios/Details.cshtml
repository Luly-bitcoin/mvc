@using System.Linq
@model mvc.Models.Propietario

@{
    ViewData["Title"] = "Detalle del propietario";

    string iniciales = "";

    if (!string.IsNullOrEmpty(Model.Nombre))
        iniciales += Model.Nombre[0];

    if (!string.IsNullOrEmpty(Model.Apellido))
        iniciales += Model.Apellido[0];

    var inmuebles = Model.Inmuebles ?? new List<mvc.Models.Inmueble>();

    var totalInmuebles = inmuebles.Count;
    var disponibles = inmuebles.Count(i => i.Activo == 1);
    var noDisponibles = inmuebles.Count(i => i.Activo != 1);

    var reservas = inmuebles
        .Where(i => i.Reservas != null)
        .SelectMany(i => i.Reservas!)
        .OrderByDescending(r => r.FechaDesde)
        .ToList();
}

<div class="management-page">

    <div class="details-back">
        <a asp-action="Index" class="btn-cancel">
            ← Volver a propietarios
        </a>
    </div>

    <div class="data-card">

        <div class="details-top">

            <div>

                <div class="edit-card-header">

                    <div class="edit-avatar">
                        @iniciales.ToUpper()
                    </div>

                    <div>
                        <h2>
                            @Model.Nombre @Model.Apellido
                        </h2>

                        <span>
                            Propietario · DNI @Model.Dni
                        </span>
                    </div>

                </div>

                <div class="details-person-data">

                    <div class="details-person-grid">

                        <div class="form-group">
                            <label>Nombre</label>
                            <div>@Model.Nombre</div>
                        </div>

                        <div class="form-group">
                            <label>Apellido</label>
                            <div>@Model.Apellido</div>
                        </div>

                        <div class="form-group">
                            <label>DNI</label>
                            <div>@Model.Dni</div>
                        </div>

                        <div class="form-group">
                            <label>Teléfono</label>
                            <div>@Model.Telefono</div>
                        </div>

                        <div class="form-group">
                            <label>Email</label>
                            <div>@Model.Email</div>
                        </div>

                    </div>

                </div>

            </div>

            <div class="details-summary">

                <div class="details-summary-header">

                    <h2>Resumen</h2>

                    <span class="data-count">
                        Actividad del propietario
                    </span>

                </div>

                <div class="details-summary-grid">

                    <div class="details-summary-item">
                        <strong>@totalInmuebles</strong>
                        <span>Inmuebles</span>
                    </div>

                    <div class="details-summary-item">
                        <strong>@disponibles</strong>
                        <span>Disponibles</span>
                    </div>

                    <div class="details-summary-item">
                        <strong>@noDisponibles</strong>
                        <span>No disponibles</span>
                    </div>

                    <div class="details-summary-item">
                        <strong>@reservas.Count</strong>
                        <span>Alquileres registrados</span>
                    </div>

                </div>

            </div>  

        </div>
        
    </div>


    <div class="details-history">

        <div class="page-header">
            <div>
                <h1>INMUEBLES Y ALQUILERES</h1>
            </div>
        </div>


        @if (inmuebles.Any())
        {
            foreach (mvc.Models.Inmueble inmueble in inmuebles)
            {
                var reservasInmueble = inmueble.Reservas == null
                    ? new List<mvc.Models.Reserva>()
                    : inmueble.Reservas
                        .OrderByDescending(r => r.FechaDesde)
                        .ToList();

                <div class="data-card history-year">

                    <div class="data-card-header">

                        <div>
                            <h2>
                                @inmueble.TipoNombre
                            </h2>

                            <span class="data-count">
                                @inmueble.Direccion
                            </span>
                        </div>

                        <span class="status-badge @(inmueble.Activo == 1 ? "status-available" : "status-rented")">
                            @inmueble.Estado.ToUpper()
                        </span>

                    </div>


                    <div class="property-event">

                        <div class="property-event-header">

                            <div>
                                <h3>
                                    @inmueble.Direccion
                                </h3>

                                <span>
                                    @inmueble.TipoNombre
                                </span>
                            </div>

                        </div>

                        <div class="property-event-details">

                            <div>
                                <small>PRECIO</small>

                                <div>
                                    $@inmueble.Precio.ToString("N0")
                                </div>
                            </div>

                            <div>
                                <small>ESTADO ACTUAL</small>

                                <div class="payment-ok">
                                    ✓ @inmueble.Estado
                                </div>
                            </div>

                        </div>

                    </div>


                    <div style="margin-top: 25px;">

                        <h3 style="margin-bottom: 15px; margin-left: 20px">
                            Historial de alquileres
                        </h3>

                        @if (reservasInmueble.Any())
                        {
                            foreach (var reserva in reservasInmueble)
                            {
                                <div class="history-event">

                                    <div class="history-date">
                                        @reserva.FechaDesde.ToString("dd/MM/yyyy")
                                    </div>

                                    <div class="property-event">

                                        <div class="property-event-header">

                                            <div>

                                                <h3>
                                                    @if (!string.IsNullOrWhiteSpace(reserva.InquilinoNombre))
                                                    {
                                                        @reserva.InquilinoNombre
                                                    }
                                                    else
                                                    {
                                                        <span>
                                                            Inquilino no disponible
                                                        </span>
                                                    }
                                                </h3>

                                                <span>
                                                    Reserva #@reserva.Id
                                                </span>

                                            </div>

                                            <span class="status-badge @(reserva.Activo == 1 ? "status-rented" : "status-available")">

                                                @(reserva.Activo == 1
                                                    ? "ALQUILER ACTUAL"
                                                    : "FINALIZADO")

                                            </span>

                                        </div>


                                        <div class="property-event-details">

                                            <div>

                                                <small>PERÍODO</small>

                                                <div>
                                                    @reserva.FechaDesde.ToString("dd/MM/yyyy")
                                                    →
                                                    @reserva.FechaHasta.ToString("dd/MM/yyyy")
                                                </div>

                                            </div>


                                            <div>

                                                <small>MONTO DIARIO</small>

                                                <div>
                                                    $@reserva.MontoDiario.ToString("N0")
                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="history-empty">

                                Este inmueble todavía no tiene
                                alquileres registrados.

                            </div>
                        }

                    </div>

                </div>
            }
        }
        else
        {
            <div class="data-card history-year">

                <div class="history-empty">

                    Este propietario no tiene inmuebles registrados.

                </div>

            </div>
        }

    </div>

</div>