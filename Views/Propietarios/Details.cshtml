@using System.Linq
@model mvc.Models.Propietario

@{
    ViewData["Title"] = "Detalle del propietario";

    string iniciales = "";

    if (!string.IsNullOrEmpty(Model.Nombre))
        iniciales += Model.Nombre[0];

    if (!string.IsNullOrEmpty(Model.Apellido))
        iniciales += Model.Apellido[0];
}

<div class="management-page">

    <div class="details-back">
        <a asp-action="Index" class="btn-cancel">
            ← Volver a propietarios
        </a>
    </div>

    <div class="data-card">

        <div class="details-top">

            <div>

                <div class="edit-card-header">

                    <div class="edit-avatar">
                        @iniciales.ToUpper()
                    </div>

                    <div>
                        <h2>
                            @Model.Nombre @Model.Apellido
                        </h2>

                        <span>
                            Propietario · DNI @Model.Dni
                        </span>
                    </div>

                </div>

                <div class="details-person-data">

                    <div class="details-person-grid">

                        <div class="form-group">
                            <label>Nombre</label>
                            <div>@Model.Nombre</div>
                        </div>

                        <div class="form-group">
                            <label>Apellido</label>
                            <div>@Model.Apellido</div>
                        </div>

                        <div class="form-group">
                            <label>DNI</label>
                            <div>@Model.Dni</div>
                        </div>

                        <div class="form-group">
                            <label>Teléfono</label>
                            <div>@Model.Telefono</div>
                        </div>

                        <div class="form-group">
                            <label>Email</label>
                            <div>@Model.Email</div>
                        </div>

                    </div>

                </div>

            </div>

            <div class="details-summary">

                <div class="details-summary-header">

                    <h2>Resumen</h2>

                    <span class="data-count">
                        Actividad del propietario
                    </span>

                </div>

                <div class="details-summary-grid">

                    <div class="details-summary-item">
                        <strong>@(Model.Inmuebles?.Count() ?? 0)</strong>
                        <span>Inmuebles</span>
                    </div>

                    <div class="details-summary-item">
                        <strong>@(Model.Inmuebles?.Count(i => i.Activo == 1) ?? 0)</strong>
                        <span>Disponibles</span>
                    </div>

                    <div class="details-summary-item">
                        <strong>@(Model.Inmuebles?.Count(i => i.Activo != 1) ?? 0)</strong>
                        <span>No disponibles</span>
                    </div>

                    <div class="details-summary-item">
                        <strong>@(Model.Pagos?.Count() ?? 0)</strong>
                        <span>Pagos registrados</span>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="details-history">

        <div class="page-header">
            <div>
                <h1>HISTORIAL</h1>
            </div>
        </div>

        @if (Model.Inmuebles != null && Model.Inmuebles.Any())
        {
            @foreach (var inmueble in Model.Inmuebles)
            {
                <div class="data-card history-year">

                    <div class="data-card-header">

                        <div>
                            <h2>@DateTime.Now.Year</h2>

                            <span class="data-count">
                                Actividad reciente
                            </span>
                        </div>

                    </div>

                    <div class="history-event">

                        <div class="history-date">
                            @DateTime.Now.ToString("MMMM yyyy").ToUpper()
                        </div>

                        <div class="property-event">

                            <div class="property-event-header">

                                <div>
                                    <h3>
                                        @inmueble.TipoNombre
                                    </h3>

                                    <span>
                                        @inmueble.Direccion
                                    </span>
                                </div>

                                <span class="status-badge @(inmueble.Activo == 1 ? "status-available" : "status-rented")">
                                    @inmueble.Estado.ToUpper()
                                </span>

                            </div>

                            <div class="property-event-details">

                                <div>
                                    <small>PRECIO</small>

                                    <div>
                                        $@inmueble.Precio.ToString("N0")
                                    </div>
                                </div>

                                <div>
                                    <small>ESTADO</small>

                                    <div class="payment-ok">
                                        ✓ @inmueble.Estado
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="data-card history-year">

                <div class="data-card-header">

                    <div>
                        <h2>@DateTime.Now.Year</h2>

                        <span class="data-count">
                            Historial anterior
                        </span>
                    </div>

                </div>

                <div class="history-empty">
                    No hay movimientos registrados para este período.
                </div>

            </div>
        }

    </div>

</div>